# Скопируйте в .env.dev и заполните реквизиты тестового Telegram-бота.
# Запуск: mise run start-dev. .env.dev исключён из Git.
# Общие B24_WEBHOOK и ASSEMBLYAI_API_KEY берутся из .env.
TG_BOT_TOKEN=
# ID разрешённого чата; для личного чата — ваш Telegram user ID.
# Несколько ID — через запятую. Без TG_CHAT_ID бот не запускается.
TG_CHAT_ID=
